# Copiar a .env antes del primer arranque:  cp .env.example .env
# Valores SOLO para desarrollo. Nunca commitear el .env.

# --- Puertos publicados al host (solo frontend y gateway) ---
GATEWAY_PORT=8000
FRONTEND_PORT=3000

# --- PostgreSQL (superusuario del contenedor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# --- Credenciales por servicio (cada usuario solo accede a su base) ---
AUTH_DB_PASSWORD=auth_dev
EVENTOS_DB_PASSWORD=eventos_dev
VENTAS_DB_PASSWORD=ventas_dev
GATEWAY_DB_PASSWORD=gateway_dev

# --- JWT (compartido entre auth y gateway) ---
JWT_SECRET=cambiar-este-secreto-en-cada-entorno
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=7

# --- Administrador inicial (seed idempotente de auth) ---
ADMIN_EMAIL=admin@ticketera.local
ADMIN_PASSWORD=admin_dev_123

# --- Rate limit por IP y minuto ---
RATE_LIMIT_AUTH=10
RATE_LIMIT_COMPRA=20
RATE_LIMIT_GENERAL=100

# --- Reservas de tickets ---
RESERVA_TTL_MINUTES=5
RESERVA_MAX_TICKETS=10

# --- Email (auth) ---
# En desarrollo apunta al contenedor mailpit (interno, no entrega nada).
# En produccion: datos de un proveedor SMTP real (SendGrid, SES, ...).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=no-reply@ticketera.local
# Base de los links que llegan por email (verificar, restablecer)
FRONTEND_URL=http://localhost:3000

# --- Frontend / CORS ---
CORS_ORIGINS=http://localhost:3000
VITE_API_URL=http://localhost:8000
